AI_STOCK_ENVIRONMENT=docker
AI_STOCK_DATABASE_URL=postgresql://ai_stock:change_me@postgres:5432/ai_stock

POSTGRES_DB=ai_stock
POSTGRES_USER=ai_stock
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

SOURCE_DATA_SERVICE_PORT=8041
HOT_CANDIDATES_SERVICE_PORT=8031
CANDIDATE_MEMORY_SERVICE_PORT=8032
AMBUSH_WATCHLIST_SERVICE_PORT=8033
SCHEDULER_SERVICE_PORT=8023

SOURCE_DATA_PROVIDER_TIMEOUT_SECONDS=12
SOURCE_DATA_PROVIDER_MAX_RETRIES=2
SOURCE_DATA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
SOURCE_DATA_CIRCUIT_BREAKER_RECOVERY_SECONDS=60
SOURCE_DATA_TUSHARE_TOKEN=

# DS-5 durable producer/consumer queue. Production must use postgres.
SOURCE_DATA_QUEUE_BACKEND=postgres
SOURCE_DATA_WORKER_ID=source-data-worker-1
SOURCE_DATA_WORKER_MAX_JOBS=5
SOURCE_DATA_WORKER_LEASE_SECONDS=120
SOURCE_DATA_WORKER_POLL_SECONDS=1
# Keep true for queue dry-run validation; switch to false only after provider probes pass.
SOURCE_DATA_WORKER_DRY_RUN_PROVIDER=true
